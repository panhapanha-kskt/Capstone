# Microsoft Defender TI credentials (optional)
MDTI_CLIENT_ID=
MDTI_CLIENT_SECRET=
MDTI_TENANT_ID=

# Override default model directory (optional)
DNS_DETECT_MODELS_DIR=

# Override DNS log source directory (optional)
DNS_DETECT_LOG_DIR=

# Technitium DNS Server API token (Settings > Sessions, or /api/user/createToken).
# Doubles as the shared secret infra/technitium-apps/PushLogger must send back as "pushToken"
# to scripts/technitium_push_listener.py, unless TECHNITIUM_PUSH_TOKEN below is set instead.
TECHNITIUM_API_KEY=

# Optional: use a separate secret for the push listener instead of reusing TECHNITIUM_API_KEY.
TECHNITIUM_PUSH_TOKEN=
