# Data outputs
!data/processed/.gitkeep

# Outputs
outputs/
!outputs/.gitkeep

# Logs
logs/
!logs/.gitkeep
*.log

# Environment
.env
*.key

# PushLogger: machine-specific build artifacts, rebuilt by scripts/setup_pushlogger.sh
infra/technitium-apps/PushLogger.zip
infra/technitium-apps/.built_version
infra/technitium-apps/PushLogger/bin/
infra/technitium-apps/PushLogger/obj/
scripts/.push_listener.log
# Cloned Technitium source + build output (infra/technitium-apps/build.sh) - not our code
infra/technitium-build/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Compiled binaries
attacks/attack
*.o
*.exe

# processed data: ignore by default, track json outputs
data/processed/*
!data/processed/.gitkeep
!data/processed/*.json

# Claude Code: share skills in the repo, keep machine-local settings out
.claude/settings.local.json

# Experiment model folders (DNS_DETECT_MODELS_DIR)
models_*/
.venv/

# DNSTunnel2026 extracted copy (train.csv is 3.6 GB, over GitHub's 2 GB LFS limit)
DNSTunnel2026/

# Experiment run folders (models, copied training data, run records): keep out of git
runs/

# Archived live models (moved by scripts/promote_model.sh): kept on disk, not in git
models/archive/
models/PROMOTED.json
data/external/tu2023/
